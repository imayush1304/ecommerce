# Copy this file to config.env and fill in your own values
# DO NOT commit config.env — it is gitignored

NODE_ENV=development
PORT=8000

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
REACT_APP_BACKEND_URL=http://localhost:8000

# Database (MongoDB Atlas)
DB_LOCAL_URI=your_mongodb_atlas_connection_string

# JWT Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# Google OAuth
# Add these redirect URIs in Google Cloud Console:
# - http://localhost:8000/api/auth/google/callback
# - https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Cloudinary (image uploads)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Stripe Payments
STRIPE_API_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email (Gmail App Password recommended)
# 1) Enable 2-Step Verification on your Google account
# 2) Create an "App Password" at myaccount.google.com/apppasswords
EMAIL_PROVIDER=gmail
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=VIPcart
SMTP_FROM_EMAIL=your_gmail@gmail.com

# Or use generic SMTP provider:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
