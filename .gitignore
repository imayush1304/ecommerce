# ============================================================
# VIPcart — MERN E-Commerce .gitignore
# ============================================================

# ---------------------------
# Node / npm
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ---------------------------
# Environment & Secrets
# ---------------------------
.env
.env.*
!.env.example
config.env
backend/config/config.env

# ---------------------------
# Build Outputs
# ---------------------------
/build
frontend/build/
dist/

# ---------------------------
# Uploaded / Runtime Files
# ---------------------------
backend/uploads/
backend/data/uploads/

# ---------------------------
# Logs
# ---------------------------
logs/
*.log

# ---------------------------
# OS & Editor
# ---------------------------
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------
# Misc
# ---------------------------
new.txt
*.tmp
*.bak
